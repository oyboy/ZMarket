<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<name>Zmarket</name>
	<description>Super project on Spring Boot</description>
	<groupId>com.scammers</groupId>
	<artifactId>Zmarket</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.6</version>
		<relativePath/>
	</parent>

	<properties>
		<java.version>21</java.version>
	</properties>

    <packaging>pom</packaging>
	<modules>
		<module>backend/configserver</module>
		<module>backend/eurekaserver</module>
		<module>backend/gatewayserver</module>
		<module>backend/order-service</module>
		<module>backend/product-service</module>
        <module>backend/review-aggregate-service</module>
        <module>backend/user-service</module>
        <module>backend/cart-service</module>
        <module>backend/warehouse-service</module>
	</modules>
	<build>
		<plugins>
			<plugin>
				<groupId>com.spotify</groupId>
				<artifactId>dockerfile-maven-plugin</artifactId>
				<version>1.4.13</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
